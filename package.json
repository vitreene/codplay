{
  "name": "codplay-monorepo",
  "version": "0.0.1",
  "description": "Codplay monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitreene/codplay.git"
  },
  "license": "ISC",
  "author": "vitreene",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/codplay",
    "packages/demos",
    "packages/editor",
    "packages/authoring/*",
    "packages/authoring/components/*"
  ],
  "scripts": {
    "dev:demos": "npm run dev --workspace=packages/demos",
    "dev:editor": "npm run dev --workspace=packages/editor",
    "test": "npm run test --workspace=packages/codplay",
    "test:gates": "npm run test:gates --workspace=packages/codplay",
    "build": "npm run build --workspace=packages/codplay"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
