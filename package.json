{
  "name": "codplay-monorepo",
  "version": "0.0.1",
  "description": "Codplay monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitreene/codplay.git"
  },
  "license": "ISC",
  "author": "vitreene",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/codplay",
    "packages/codplay-v2",
    "packages/demos",
    "packages/editor",
    "packages/authoring/*",
    "packages/authoring/components/*"
  ],
  "scripts": {
    "dev:demos": "npm run dev --workspace=packages/demos",
    "dev:editor": "npm run dev --workspace=packages/editor",
    "demo:flip": "npm run demo:flip --workspace=@codplay/selection-frame",
    "demo:flip:stress": "npm run demo:flip-stress --workspace=@codplay/selection-frame",
    "test": "npm run test --workspace=packages/codplay",
    "test:gates": "npm run test:gates --workspace=packages/codplay",
    "build": "npm run build --workspace=packages/codplay"
  },
  "devDependencies": {
    "@types/three": "^0.185.0",
    "typescript": "~6.0.3"
  }
}
