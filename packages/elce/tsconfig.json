{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "remix/ui",
    "paths": {
      "codplay": ["../codplay/src/index.ts"],
      "codplay/*": ["../codplay/src/*"],
      "ace": ["../codplay/src/ace/index.ts"],
      "ace/*": ["../codplay/src/ace/*"],
      "@codplay/capsule-automation": ["../authoring/capsule-automation/src/index.ts"],
      "@codplay/capsule-automation/*": ["../authoring/capsule-automation/src/*"],
      "@codplay/scene-factory/capsule-distribution": ["../authoring/scene-factory/src/capsule-distribution.ts"],
      "@codplay/scene-factory/capsule-preset": ["../authoring/scene-factory/src/capsule-preset.ts"],
      "@codplay/sighty": ["../sighty/src/index.ts"],
      "@codplay/component-v2": ["../authoring/component-v2/src/index.ts"],
      "@codplay/component-v2/*": ["../authoring/component-v2/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
