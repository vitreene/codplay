{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "remix/component",
    "paths": {
      "codplay": ["../codplay/src/index.ts"],
      "codplay/*": ["../codplay/src/*"],
      "ace": ["../codplay/src/ace/index.ts"],
      "ace/*": ["../codplay/src/ace/*"],
      "@codplay/capsule-automation": ["../authoring/capsule-automation/src/index.ts"],
      "@codplay/capsule-automation/*": ["../authoring/capsule-automation/src/*"],
      "@codplay/audio-capture": ["../authoring/audio-capture/src/index.ts"],
      "@codplay/exclusive-sync": ["../authoring/exclusive-sync/src/index.ts"],
      "@codplay/scene-factory/capsule-distribution": ["../authoring/scene-factory/src/capsule-distribution.ts"],
      "@codplay/scene-factory/capsule-preset": ["../authoring/scene-factory/src/capsule-preset.ts"],
      "@codplay/story/rive-talking-avatar": ["../authoring/story/rive-talking-avatar/index.ts"],
      "@codplay/remote/remote": ["../authoring/remote/src/remote.ts"],
      "@codplay/sighty": ["../sighty/src/index.ts"],
      "@codplay/sighty-scorm": ["../sighty-scorm/src/index.ts"],
      "@codplay/sighty-scorm/session": ["../sighty-scorm/src/scorm-session.ts"],
      "@codplay/sighty-scorm/limits": ["../sighty-scorm/src/scorm-data-limits.ts"],
      "@codplay/component-v2": ["../authoring/component-v2/src/index.ts"],
      "@codplay/component-v2/*": ["../authoring/component-v2/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
