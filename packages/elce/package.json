{
  "name": "@codplay/elce",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.3.0"
  },
  "scripts": {
    "dev": "node scripts/dev-elce.mjs",
    "predev": "npm run generate:appearance",
    "dev:network": "ELCE_NETWORK_PREVIEW=1 node scripts/dev-elce.mjs",
    "predev:network": "npm run generate:appearance",
    "dev:api": "node scripts/dev-api.mjs",
    "package-scorm": "node scripts/package-scorm.mjs",
    "prepackage-scorm": "npm run generate:appearance",
    "build": "vite build",
    "prebuild": "npm run generate:appearance",
    "preview": "vite preview",
    "prepreview": "npm run generate:appearance",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run generate:appearance",
    "test": "vitest run",
    "pretest": "npm run generate:appearance",
    "generate:appearance": "node scripts/generate-appearance-palette-metadata.mjs"
  },
  "dependencies": {
    "@codplay/exclusive-sync": "*",
    "@codplay/capsule-automation": "*",
    "@codplay/component-v2": "*",
    "@codplay/scene-factory": "*",
    "@codplay/sighty": "*",
    "@codplay/sighty-scorm": "*",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-subscript": "^3.31.4",
    "@tiptap/extension-superscript": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "codplay": "*",
    "es-module-lexer": "^2.1.0",
    "fflate": "~0.8.2",
    "lucide-static": "^1.23.0",
    "magic-string": "^0.30.21",
    "remix": "3.0.0-rc.4",
    "xstate": "^5.32.2"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
