		<properties name="tel" showAfter="Y" width="320" backgroundColor="0x90a9d4" cssClass="schema-pop" />
		<properties name="subs" showAfter="Y" cssClass="note" textAlign="left" textSize="16" textColor="0x333333" />
		<properties name="num" showAfter="Y" cssClass="isBold badge" textSize="20" effect="growDown" />
		<properties name="pops" showAfter="Y" centered="Y" width="230" textAlign="center" textSize="26" backgroundColor="0x333333" cssClass="notes-pop center" />
		<properties name="chef" showAfter="Y" width="200" textSize="16" cssClass="isBold notes-pop center" />

		<properties name="question" width="100%" textAlign="left" textSize="38" textColor="#0062a8" effect="fromTop" effectEase="Back.easeOut" />
		<properties name="cartouche" delay="0" showAfter="Y" left="50%" top="50%" centered="Y" width="1000" backgroundColor="#ddeeee" />
		<properties name="fondQuizz" x="center" y="center" centered="Y" width="2000" height="1600" backgroundColor="#2a80bd" />

		<properties name="manyMany" id="context" delay="1" src="manyMany" textSize="24" textAlign="left" effect="fromRight" />

	</globalProperties>
