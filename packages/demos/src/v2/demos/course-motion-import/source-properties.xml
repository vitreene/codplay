		<properties name="ver" backgroundColor="0x2eb61f" textColor="0xffffff" />
		<properties name="orj" backgroundColor="0xed7d31" textColor="0xffffff" />
		<properties name="gry" backgroundColor="0xdfdfdf" textColor="0x333333" />
		<properties name="grd" backgroundColor="0x676767" textColor="0xffffff" />
		<properties name="jon" backgroundColor="0xe8d82c" textColor="0x333333" />

		<properties name="list-item-head" showAfter="Y" cssClass="list-item item-head isBold" textAlign="left" effect="fromBottom" />
