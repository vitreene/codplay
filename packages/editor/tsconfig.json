{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "codplay": ["../codplay/src/index.ts"],
      "codplay/*": ["../codplay/src/*"],
      "ace": ["../codplay/src/ace/index.ts"],
      "ace/*": ["../codplay/src/ace/*"],
      "@codplay/selection-frame/v2": ["../authoring/selection-frame/src/v2.ts"],
      "@codplay/capsule-automation": ["../authoring/capsule-automation/src/index.ts"],
      "@codplay/capsule-automation/*": ["../authoring/capsule-automation/src/*"],
      "@codplay/scene-factory": ["../authoring/scene-factory/src/index.ts"],
      "@codplay/scene-factory/*": ["../authoring/scene-factory/src/*"],
      "@codplay/text-auto-size": ["../authoring/text-auto-size/src/index.ts"],
      "@codplay/text-auto-size/*": ["../authoring/text-auto-size/src/*"]
